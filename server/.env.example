# ---------------------------------------------------------------------------
# Rwanda Parcel Fabric – backend configuration template
# Copy to `server/.env` (git-ignored). Never commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Public origin(s) of the web app (comma separated). Used for CORS and as the
# Referer when validating referer-bound Portal tokens.
APP_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ArcGIS Enterprise (federated) — no secrets here, these are public URLs.
PORTAL_URL=https://esrirw.rw/portal
ARCGIS_SERVER_URL=https://esrirw.rw/server
PARCEL_SERVICE_PATH=ParcelFabric

# Optional: OAuth 2.0 app registered in Portal (Content > New item > Application).
# Without it the app uses the ArcGIS IdentityManager sign-in dialog (generateToken over HTTPS).
ARCGIS_OAUTH_APP_ID=

# Optional: Portal group IDs that grant application roles. Leave empty to derive
# roles from Portal role/privileges only (org admin -> Administrator,
# features:user:edit -> GIS Editor, otherwise Viewer). Surveyor requires a group.
ROLE_GROUP_ADMIN=
ROLE_GROUP_EDITOR=
ROLE_GROUP_SURVEYOR=

# Where the audit log and per-user bookmarks are stored (relative to the server folder).
AUDIT_DIR=data/audit
BOOKMARKS_DIR=data/bookmarks

# API documentation (OpenAPI + Swagger UI) at /api/docs. Default: on, except when NODE_ENV=production.
# API_DOCS=true

# Optional – only for `npm run inspect-services` (CLI metadata inspection).
# Use a named Portal account; never the database owner.
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
