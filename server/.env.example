# ---------------------------------------------------------------------------
# Rwanda Parcel Fabric – backend configuration template
# Copy to `server/.env` (git-ignored). Never commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Public origin(s) of the web app (comma separated). Used for CORS and as the
# Referer when validating referer-bound Portal tokens.
APP_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ArcGIS Enterprise (federated) — no secrets here, these are public URLs.
PORTAL_URL=https://esrirw.rw/portal
ARCGIS_SERVER_URL=https://esrirw.rw/server
PARCEL_SERVICE_PATH=ParcelFabric
# Each ArcGIS service can be set on its own. Empty = <ARCGIS_SERVER_URL>/rest/services/<PARCEL_SERVICE_PATH>/<Service>.
FEATURE_SERVER_URL=
MAP_SERVER_URL=
PARCEL_FABRIC_SERVER_URL=
VERSION_MANAGEMENT_SERVER_URL=
VALIDATION_SERVER_URL=

# Optional: OAuth 2.0 app registered in Portal (Content > New item > Application).
# Without it the app uses the ArcGIS IdentityManager sign-in dialog (generateToken over HTTPS).
ARCGIS_OAUTH_APP_ID=

# Optional: Portal group IDs that grant application roles. Leave empty to derive
# roles from Portal role/privileges only (org admin -> Administrator,
# features:user:edit -> GIS Editor, otherwise Viewer). Surveyor requires a group.
ROLE_GROUP_ADMIN=
ROLE_GROUP_EDITOR=
ROLE_GROUP_SURVEYOR=

# LAIS server-to-server integration. Keep all credentials in server/.env or a
# secrets manager; never put them in the React app, repository, or LAIS payload.
# The API key (header X-API-Key, at least 32 characters). It does not expire and opens EVERY endpoint,
# so keep it on servers only. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAIS_API_KEY=
# Only while changing the key: put the OLD key here and the new one in LAIS_API_KEY, restart, let
# LAIS switch to the new key, then empty this and restart again. Both work in between (no downtime).
LAIS_API_KEY_PREVIOUS=
# Dedicated Portal account (with an editor user type) that queries the Plot layer, creates the
# public LAIS_* versions it owns and edits Plot attributes inside them. It never posts.
# Do not use a Portal administrator or DB owner.
LAIS_ARCGIS_USERNAME=
LAIS_ARCGIS_PASSWORD=
# Referer bound into the service account's token; sent on every ArcGIS call.
LAIS_ARCGIS_REFERER=https://your-server-host.example
# Branch-versioned Plot layer holding the transaction fields. Default: <FeatureServer>/17.
LAIS_PARCEL_LAYER_URL=
# attributes (default): write the transaction fields (transaction_id, transaction_type, transaction_status,
# transaction_date, case_, validation_message, version_status, version_name) on the Plot inside the version.
# Needs the Portal "Advanced Editing" user type extension on the account.
# version-only: the account only creates the public version.
LAIS_WRITE_MODE=attributes
# Ledger of accepted transactions (idempotency + status), relative to the server folder.
LAIS_DATA_DIR=data/lais

# GIS → LAIS "editing done" notification (the editor's "Editing done" button).
# Keep false until LAIS's endpoint AND the GIS approve endpoint are ready: once true, editors stop
# posting LAIS versions themselves and wait for the registrar's approval.
LAIS_EDITING_DONE=false
# The LAIS endpoint, e.g. http://192.168.160.188:8000/transaction/processed, and the key LAIS issued
# to GIS (sent as X-API-Key). The JSON notification is sent with LAIS_WEBHOOK_METHOD (PUT, or POST).
# For local testing: npm run mock-lais, then LAIS_WEBHOOK_URL=http://127.0.0.1:4010/transaction/processed
LAIS_WEBHOOK_URL=
LAIS_WEBHOOK_KEY=
LAIS_WEBHOOK_METHOD=PUT
LAIS_WEBHOOK_TIMEOUT_MS=10000
# Editors can also finish a transaction by setting the Plot field editing_status = "Edits done" on the
# new parcels (e.g. in ArcGIS Pro): GIS checks open LAIS versions this often (ms) and sends "Editing done"
# itself. 0 = only the web-app button (which also writes the field).
LAIS_EDITS_DONE_SCAN_MS=120000

# Subdivision completion webhook to App B (docs/SUBDIVISION-WEBHOOK.md). Off by default.
# When enabled: URL must be https:// (http:// only for localhost) and the secret at least 32 characters.
SUBDIVISION_WEBHOOK_ENABLED=false
SUBDIVISION_WEBHOOK_URL=
SUBDIVISION_WEBHOOK_SECRET=
# Only during a key change (then empty it again):
SUBDIVISION_WEBHOOK_SECRET_PREVIOUS=
SUBDIVISION_WEBHOOK_TIMEOUT_MS=10000
SUBDIVISION_WEBHOOK_MAX_ATTEMPTS=12
SUBDIVISION_WEBHOOK_BACKOFF_BASE_MS=30000
SUBDIVISION_WEBHOOK_BACKOFF_MAX_MS=21600000
SUBDIVISION_WEBHOOK_RECONCILE_INTERVAL_MS=300000
SUBDIVISION_WEBHOOK_DISPATCH_INTERVAL_MS=15000
# Only transactions accepted since this ISO date; empty = since the webhook was first enabled.
SUBDIVISION_WEBHOOK_SINCE=

# Where the audit log and per-user bookmarks are stored (relative to the server folder).
AUDIT_DIR=data/audit
BOOKMARKS_DIR=data/bookmarks

# API documentation (OpenAPI + Swagger UI) at /api/docs. Default: on, except in production.
# API_DOCS=true

# Optional – only for npm run inspect-services (CLI metadata inspection).
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
