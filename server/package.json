{
  "name": "rwanda-parcel-fabric-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect-services": "tsx --env-file-if-exists=.env src/scripts/inspectServices.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.1.0",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "swagger-ui-dist": "5.34.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "scarfSettings": {
    "enabled": false
  }
}
