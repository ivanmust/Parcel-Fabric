{
  "name": "rwanda-parcel-fabric",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --port 5174",
    "test:unit": "node --test tests/unit/shapefile.test.mjs tests/unit/adjacency.test.mjs tests/unit/topologyErrors.test.mjs tests/unit/editingDoneNotice.test.mjs",
    "test:e2e:workspace": "node tests/e2e/workspace-test.mjs",
    "test:e2e:search": "node tests/e2e/search-test.mjs",
    "test:e2e:phase2": "node tests/e2e/phase2-ui.mjs",
    "test:e2e:editing": "node tests/e2e/phase2-test.mjs",
    "test:e2e:tools": "node tests/e2e/editing-tools-test.mjs",
    "test:e2e:split": "node tests/e2e/split-validate-upload-test.mjs",
    "test:e2e:topology": "node tests/e2e/topology-errors-test.mjs",
    "test:e2e:cleanup": "node tests/e2e/cleanup-versions.mjs"
  },
  "dependencies": {
    "@arcgis/core": "5.1.27",
    "@arcgis/map-components": "5.1.27",
    "@esri/calcite-components": "5.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "puppeteer-core": "25.18.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8"
  }
}
